# Only keys generated at https://testnet.binance.vision/ belong here.
# Never use a Binance production key. This file's local copy is ignored by Git.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# For an Ed25519 key, set PRIVATE_KEY_PATH instead of API_SECRET.
BINANCE_TESTNET_PRIVATE_KEY_PATH=
TESTNET_SYMBOL=BTCUSDT
TESTNET_INTERVAL=5m
TESTNET_FAST_PERIOD=9
TESTNET_SLOW_PERIOD=21
TESTNET_TRADE_USDT=100
TESTNET_STOP_LOSS_PERCENT=1.5
TESTNET_TAKE_PROFIT_PERCENT=3
TESTNET_POLL_SECONDS=60
