# Exported template: all credential fields are blank. Configure private-key paths locally.
# Testnet only. Never paste keys into chat or commit your actual .env.testnet.
# Copy to .env.testnet ONLY for a new installation, not over existing keys.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_PRIVATE_KEY_PATH=
# Choose HMAC secret OR local Ed25519 private-key path, never both.
# The virtual launcher applies strategies/virtual-only.json after this file.
TESTNET_STRATEGY=adaptive
TESTNET_ADAPTIVE_PROFILE=short
TESTNET_SYMBOL=BTCUSDT
TESTNET_INTERVAL=1m
TESTNET_FAST_PERIOD=3
TESTNET_SLOW_PERIOD=8
TESTNET_POLL_SECONDS=5
TESTNET_TRADE_USDT=100
TESTNET_STOP_LOSS_PERCENT=0.15
TESTNET_TAKE_PROFIT_PERCENT=0.15
TESTNET_MAX_HOLD_MINUTES=3
TESTNET_COOLDOWN_SECONDS=10
TESTNET_MAX_BUYS_PER_HOUR=60
