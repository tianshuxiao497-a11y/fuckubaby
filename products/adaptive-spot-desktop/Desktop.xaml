<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#0B1020">
  <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0E1528" BorderBrush="#202C45" BorderThickness="0,0,1,0">
    <DockPanel Margin="20,28,18,20">
      <StackPanel DockPanel.Dock="Top">
        <Image x:Name="BrandImage" Width="54" Height="54" HorizontalAlignment="Left" Margin="0,0,0,15"/>
        <TextBlock Text="Adaptive" FontSize="25" FontWeight="Bold" Foreground="#F4F7FF"/>
        <TextBlock Text="Spot Bot" FontSize="25" FontWeight="Bold" Foreground="#F4F7FF"/>
        <Border CornerRadius="5" Background="#223735" Padding="8,4" HorizontalAlignment="Left" Margin="0,14,0,28"><TextBlock Text="TESTNET EDITION" Foreground="#6EE7B7" FontSize="10" FontWeight="Bold"/></Border>
        <Button x:Name="NavOverview" Content="◉   交易总览" Style="{DynamicResource NavigationButton}"/>
        <Button x:Name="NavConnection" Content="⌁   密钥配置" Style="{DynamicResource NavigationButton}"/>
        <Button x:Name="NavLicense" Content="◇   订阅授权" Style="{DynamicResource NavigationButton}"/>
        <Button x:Name="NavActivity" Content="≡   运行记录" Style="{DynamicResource NavigationButton}"/>
        <Button x:Name="NavHelp" Content="?   帮助与安全" Style="{DynamicResource NavigationButton}"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
        <Border Background="#1A2440" CornerRadius="10" Padding="12" Margin="0,18,0,14">
          <StackPanel><TextBlock Text="LOCAL-FIRST" Foreground="#C4B5FD" FontWeight="SemiBold" FontSize="10"/><TextBlock Text="密钥留在本机&#10;不代管资金 · 不接实盘" Foreground="#9CAECC" FontSize="11" LineHeight="21" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <TextBlock x:Name="VersionText" Text="DESKTOP 0.3.0" Foreground="#637695" FontSize="10"/>
      </StackPanel>
    </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,28,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="PageTitle" Text="交易总览" Foreground="#F1F5FF" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Your strategy. Your machine. Virtual funds only." Foreground="#8D9FBD" FontSize="12" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox x:Name="SymbolSelect" Width="160" Height="32" Margin="0,0,8,0" SelectedValuePath="Tag" SelectedIndex="0" Foreground="#102238" Background="#E8F0FB"><ComboBoxItem Tag="BTCUSDT" Content="BTC / USDT"/></ComboBox>
        <Button x:Name="MarketsButton" Content="刷新币种" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,0" Padding="10,6"/>
        <Border Background="#303020" BorderBrush="#635530" BorderThickness="1" CornerRadius="8" Padding="10,7"><TextBlock Text="●  仅测试网" Foreground="#FDE68A" FontWeight="SemiBold" FontSize="11"/></Border>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" x:Name="Banner" CornerRadius="10" Background="#182743" BorderBrush="#2B4669" BorderThickness="1" Padding="14,12" Margin="0,0,0,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="BannerTitle" Text="先连接你自己的测试网账户" Foreground="#D6EDFF" FontWeight="SemiBold"/><TextBlock x:Name="BannerDetail" Text="看板已经就绪。完成密钥配置并只读测试连接后，才能手动启用虚拟交易。" Foreground="#9AB3D2" FontSize="11" TextWrapping="Wrap" Margin="0,4,14,0"/></StackPanel>
        <Button x:Name="ConfigureCta" Grid.Column="1" Content="配置测试网  →" Style="{DynamicResource PrimaryButton}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <ScrollViewer x:Name="MainScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
      <Grid>
        <StackPanel x:Name="OverviewView">
          <UniformGrid Columns="4" Margin="0,0,-12,16">
            <Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock x:Name="PriceLabel" Text="BTC / USDT 价格" Foreground="#95A7C4" FontSize="11"/><TextBlock x:Name="PriceValue" Text="— —" Foreground="#F3F7FF" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="PriceDetail" Text="尚未取得测试网行情" Foreground="#657C9D" FontSize="10"/></StackPanel></Border>
            <Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="虚拟可用余额 / USDT" Foreground="#95A7C4" FontSize="11"/><TextBlock x:Name="BalanceValue" Text="— —" Foreground="#67E8F9" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="BalanceDetail" Text="未连接账户" Foreground="#657C9D" FontSize="10"/></StackPanel></Border>
            <Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock x:Name="PositionLabel" Text="程序持仓 / BTC" Foreground="#95A7C4" FontSize="11"/><TextBlock x:Name="PositionValue" Text="— —" Foreground="#C4B5FD" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="PositionDetail" Text="只统计本程序记录" Foreground="#657C9D" FontSize="10"/></StackPanel></Border>
            <Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="本机订单记录" Foreground="#95A7C4" FontSize="11"/><TextBlock x:Name="OrderValue" Text="— —" Foreground="#F3F7FF" FontSize="27" FontWeight="SemiBold" Margin="0,10,0,5"/><TextBlock x:Name="OrderDetail" Text="不是账户全部历史" Foreground="#657C9D" FontSize="10"/></StackPanel></Border>
          </UniformGrid>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="14" Padding="20">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="行情走势" Foreground="#E7EFFD" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="最近 60 根 · 1 分钟已收盘价格线" Foreground="#7E94B6" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="ChartSource" Grid.Column="1" Text="●  NO DATA" Foreground="#647B9C" FontSize="10" VerticalAlignment="Center"/></Grid>
                <Grid Grid.Row="1" Height="206" ClipToBounds="True"><Canvas x:Name="PriceCanvas" Background="Transparent"/><StackPanel x:Name="ChartEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⌁" FontSize="42" Foreground="#33445F" HorizontalAlignment="Center"/><TextBlock Text="等待连接测试网行情" Foreground="#93A7C6" FontSize="13" HorizontalAlignment="Center"/><TextBlock Text="没有行情时不生成虚构价格或曲线" Foreground="#5F7495" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Grid>
                <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ChartRange" Text="BINANCE SPOT TESTNET · BTCUSDT" Foreground="#637B9B" FontSize="9"/><TextBlock x:Name="UpdatedText" Grid.Column="1" Text="未刷新" Foreground="#7B93B3" FontSize="9"/></Grid>
              </Grid>
            </Border>
            <Border Grid.Column="2" Background="#141D33" BorderBrush="#363354" BorderThickness="1" CornerRadius="14" Padding="20">
              <StackPanel>
                <TextBlock Text="策略控制 / STRATEGY" Foreground="#A6A6C9" FontSize="10" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,5"><Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#64748B" Margin="0,0,8,0"/><TextBlock x:Name="StrategyState" Text="未连接" Foreground="#F3F6FD" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                <TextBlock Text="Adaptive · Short" Foreground="#9C8BE1" FontSize="11" Margin="0,0,0,15"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="判断间隔" Foreground="#8297B8" FontSize="11"/><TextBlock Grid.Column="1" Text="约 5 秒" Foreground="#D4E0F3" FontSize="11"/></Grid>
                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="持仓预算上限" Foreground="#8297B8" FontSize="11"/><TextBlock Grid.Column="1" Text="100 虚拟 USDT" Foreground="#D4E0F3" FontSize="11"/></Grid>
                <Border Background="#0D1529" CornerRadius="8" Padding="11" Margin="0,17,0,12"><TextBlock x:Name="SignalText" Text="配置并测试连接后，由你决定何时开始。" Foreground="#8FA4C6" FontSize="11" LineHeight="18" TextWrapping="Wrap" MaxHeight="74"/></Border>
                <Button x:Name="StartButton" Content="▶  开始虚拟交易" Style="{DynamicResource PrimaryButton}" Margin="0,0,0,8"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="StopButton" Content="■  安全停止" Style="{DynamicResource SecondaryButton}" Padding="9,9"/><Button x:Name="RefreshButton" Grid.Column="2" Content="↻  刷新账户" Style="{DynamicResource SecondaryButton}" Padding="9,9"/></Grid>
              </StackPanel>
            </Border>
          </Grid>
          <Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,16">
            <StackPanel><TextBlock Text="启用前确认" Foreground="#B7C7E2" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7"/><CheckBox x:Name="VirtualConsent" Content="我确认仅使用测试网虚拟资金，不使用真实资金。"/><CheckBox x:Name="SingleConsent"><TextBlock Text="已停止同账户其他机器人；首次使用无旧程序持仓，或已完成经核对的人工迁移。" TextWrapping="Wrap" FontSize="11"/></CheckBox><TextBlock Text="停止不会平仓或撤单；关闭、休眠或断网后，本机保护规则无法持续运行。" Foreground="#887754" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
          </Border>
          <Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="13" Padding="18">
            <StackPanel><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="订单记录" Foreground="#E8F0FF" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="DESKTOP PROFILE · 最近 100 笔" Foreground="#7086A6" FontSize="10" VerticalAlignment="Center"/></Grid>
              <DataGrid x:Name="TradeGrid" MinHeight="156" MaxHeight="320"><DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="115"/>
                <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="70"/>
                <DataGridTextColumn Header="BTC 数量" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="USDT 金额" Binding="{Binding Quote}" Width="100"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="已实现损益*" Binding="{Binding Pnl}" Width="110"/>
                <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*" MinWidth="160"/>
              </DataGrid.Columns></DataGrid>
              <TextBlock x:Name="OrdersEmpty" Text="尚未加载本机订单。连接后会显示真实记录；无信号时不会强制买卖。" Foreground="#7890B3" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="LicenseView" Visibility="Collapsed">
          <Border Background="#131B2F" BorderBrush="#4B426B" BorderThickness="1" CornerRadius="14" Padding="25">
            <StackPanel>
              <TextBlock Text="订阅授权 / SUBSCRIPTION" Foreground="#C4B5FD" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock x:Name="LicenseState" Text="未激活 · 只能查看，不能启动交易" Foreground="#F1F5FF" FontSize="23" FontWeight="SemiBold" Margin="0,18,0,12"/>
              <TextBlock x:Name="LicenseUntil" Text="有效期以 Whop 服务端记录为准" Foreground="#8FA5C5" FontSize="12" Margin="0,0,0,24"/>
              <TextBlock x:Name="LicenseDevice" Text="一证一机：首次核验绑定当前设备；换机请联系卖家解绑。" Foreground="#80DCC7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"/>
              <TextBlock Text="输入 Whop 订单中的软件许可证（不是 Binance API Key）" Foreground="#BCCCE4" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <PasswordBox x:Name="LicenseKeyInput" Margin="0,0,0,16"/>
              <WrapPanel><Button x:Name="ActivateLicenseButton" Content="验证并保存许可证" Style="{DynamicResource PrimaryButton}" Margin="0,0,12,8"/><Button x:Name="ManageSubscriptionButton" Content="打开 Whop 订单 / 续费" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock Text="启动前必须联网验证；运行时每 30 秒复查。校验失败、退款撤权或到期会停止交易，不自动恢复。取消续费不提前停用，仍可用到已付费期限结束。" Foreground="#A1B4D2" FontSize="12" TextWrapping="Wrap" LineHeight="23" Margin="0,18,0,15"/>
              <TextBlock Text="重要：停用不会平仓或撤单。本机止盈止损也会停止，持仓必须自行在测试网管理。你仍可查看记录、只读连接账户并请求安全停止。无长期离线授权。" Foreground="#E3BC8A" FontSize="12" TextWrapping="Wrap" LineHeight="23"/>
              <TextBlock Text="许可证仅发往本产品的 HTTPS 授权服务；不上传 Binance 密钥、余额或成交记录。许可证在本机用 Windows DPAPI 加密保存。" Foreground="#7288AA" FontSize="11" TextWrapping="Wrap" Margin="0,20,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="ConnectionView" Visibility="Collapsed">
          <Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="14" Padding="25">
            <StackPanel>
              <TextBlock Text="连接你的 Spot Testnet" Foreground="#F1F6FF" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="密钥只存本机。保存与连接均不会下单；只有你明确点击开始并确认后才启用虚拟交易。" Foreground="#8FA5C5" FontSize="12" Margin="0,10,0,22" TextWrapping="Wrap"/>
              <TextBlock Text="01   币安 Spot Testnet 返回的 API Key（不是软件许可证或公钥）" Foreground="#BCCCE4" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <PasswordBox x:Name="ApiKeyInput" Margin="0,0,0,18"/>
              <TextBlock Text="02   选择一种签名方式：Ed25519 PEM 或 HMAC Secret" Foreground="#BCCCE4" Margin="0,0,0,8"/>
              <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PemInput" ToolTip="本机 Ed25519 私钥文件绝对路径"/><Button Grid.Column="2" x:Name="BrowseButton" Content="选择 PEM" Style="{DynamicResource SecondaryButton}"/></Grid>
              <TextBlock Text="选择 testnet-private.pem 私钥文件；已有密钥会自动找回。将下方公钥注册到币安测试网后，再复制它返回的 API Key。" Foreground="#7085A7" FontSize="11" TextWrapping="Wrap"/>
              <WrapPanel Margin="0,12,0,18"><Button x:Name="GenerateButton" Content="＋  生成／找回本机 Ed25519 密钥" Style="{DynamicResource SecondaryButton}"/><Button x:Name="OpenTestnetButton" Content="打开测试网注册  ↗" Style="{DynamicResource SecondaryButton}" Margin="10,0,0,0"/></WrapPanel>
              <TextBlock Text="HMAC Secret（仅在测试网提供此方式时填写；使用 PEM 时留空）" Foreground="#859BBA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <PasswordBox x:Name="SecretInput" Margin="0,0,0,20"/>
              <WrapPanel><Button x:Name="SaveConnectButton" Content="保存并连接（只读）  →" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,8"/><Button x:Name="SaveButton" Content="仅保存到本机" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,8"/><Button x:Name="ConnectButton" Content="重新测试连接" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock x:Name="ConnectionNote" Text="尚未配置。不要填 Binance 实盘密钥，也不要把 Secret 或私钥发给卖家。" Foreground="#97ABC8" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="公钥 / PUBLIC KEY" Foreground="#B8A7EE" FontSize="11" FontWeight="SemiBold"/><TextBox x:Name="PublicKeyOutput" Text="生成密钥后，公钥会显示在这里。" IsReadOnly="True" AcceptsReturn="True" Height="118" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12" FontFamily="Consolas"/><TextBlock Text="API Key 与 HMAC 配置由当前 Windows 用户 DPAPI 加密保存。生成的 PEM 私钥是本机未额外加密文件，保存在用户专属目录；外部 PEM 权限由你负责。" Foreground="#7288AA" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="ActivityView" Visibility="Collapsed"><Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="运行日志" Foreground="#E9F1FF" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="本次窗口会话 · 不包含密钥 · 不是交易盈利报告" Foreground="#8097BA" FontSize="11" Margin="0,9,0,18"/><TextBox x:Name="LogOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="440" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"/></StackPanel></Border></StackPanel>
        <StackPanel x:Name="HelpView" Visibility="Collapsed"><Border Background="#131B2F" BorderBrush="#26334D" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="开始之前，了解边界" Foreground="#F1F5FF" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="HelpCopy" Foreground="#A6B8D3" FontSize="13" TextWrapping="Wrap" LineHeight="25" Margin="0,18,0,22"/><WrapPanel><Button x:Name="GuideChineseButton" Content="中文使用说明" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,8"/><Button x:Name="GuideEnglishButton" Content="English guide" Style="{DynamicResource SecondaryButton}" Margin="0,0,10,8"/><Button x:Name="OpenDataButton" Content="打开本机记录目录" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border></StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterState" Text="●  本机界面已就绪 · 尚未启动交易" Foreground="#7C92B3" FontSize="10"/><TextBlock Grid.Column="1" Text="VIRTUAL FUNDS · NO PROFIT GUARANTEE" Foreground="#536986" FontSize="9" VerticalAlignment="Center"/></Grid>
  </Grid>
</Grid>
