# Exported template: all credential fields are blank. Configure private-key paths locally.
# Testnet only. Merge TESTNET_* values into your local .env.testnet.
# Never replace existing credentials with this blank template.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_PRIVATE_KEY_PATH=
TESTNET_SYMBOL=BTCUSDT
TESTNET_STRATEGY=tactical
TESTNET_INTERVAL=1m
TESTNET_FAST_PERIOD=3
TESTNET_SLOW_PERIOD=7
TESTNET_TRADE_USDT=100
TESTNET_STOP_LOSS_PERCENT=0.2
TESTNET_TAKE_PROFIT_PERCENT=0.3
TESTNET_POLL_SECONDS=10
TESTNET_MAX_HOLD_MINUTES=3
TESTNET_COOLDOWN_SECONDS=30
TESTNET_MAX_BUYS_PER_HOUR=60
