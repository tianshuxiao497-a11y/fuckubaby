# Testnet-only alternating order-flow experiment, NOT a profit strategy.
# Merge TESTNET_* settings into the ignored local .env.testnet; retain its keys.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_TESTNET_PRIVATE_KEY_PATH=
TESTNET_SYMBOL=BTCUSDT
TESTNET_STRATEGY=cycle
TESTNET_INTERVAL=1m
TESTNET_FAST_PERIOD=3
TESTNET_SLOW_PERIOD=7
TESTNET_TRADE_USDT=100
TESTNET_POLL_SECONDS=5
TESTNET_CYCLE_SECONDS=30
TESTNET_MAX_BUYS_PER_HOUR=60
